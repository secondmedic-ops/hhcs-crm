# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: login (Supabase Auth). Set as GitHub variables by START-HERE.bat and baked
# into the production build by the pipeline. Leave unset locally: RUN-LOCAL-TEST.bat runs with login off, and with no
# local Worker the app opens the in-browser demo.
# VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
# VITE_SUPABASE_ANON_KEY="<anon or publishable key>"
